# ArogyaCare Environment Configuration Example
# Vite environment variables must be prefixed with VITE_
# Note: Since this is a client-side offline-first PWA, NEVER put private API secrets in this file.

# Application Information
VITE_APP_NAME="ArogyaCare"
VITE_APP_DESCRIPTION="Offline-first rural AI symptom triage"

# Default emergency telephone number (e.g. 108 in India, 112 in EU/India, 911 in US)
VITE_DEFAULT_EMERGENCY_NUMBER="108"
